# ==============================================================================
# ResolveDesk .gitignore
# Production-ready gitignore: excludes test files, batch scripts, env/secrets,
# IDE settings, local dumps, and build artifacts not needed to run the app.
# ==============================================================================

# Java / Maven Build Artifacts
target/
*.class
*.jar
*.war
*.ear
*.nar

# Maven Wrapper Binary
.mvn/wrapper/maven-wrapper.jar

# Test Files & Test Outputs (Not required to run the app on another system)
src/test/
**/test/
*.dump
*.dumpstream
surefire*
test-results/
coverage/

# Batch & Command Scripts
*.bat
*.cmd
run.bat

# Environment, Secrets & Local Overrides
*.env
.env
.env.*
.env.local
.env.*.local
application-local.yml
application-local.properties
.spring-boot-devtools.properties

# Frontend Dependencies & Build Outputs
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
.pnp
.pnp.js

# IDEs & Editor Configuration
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.project
.classpath
.settings/

# Logs & Temporary Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Local Planning & Scratch Artifacts (Not needed to run the application)
.planning/

# Local Database Dumps & Storage
init.sql
pgdata/